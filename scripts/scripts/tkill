#!/bin/zsh
# Kill tmux sessions: the ones given as arguments, else picked in fzf (tab to select several).
# Inside tmux, detach-on-destroy off moves the client to another session.
if (( $# )); then
  sessions=("$@")
else
  sessions=("${(@f)$(tmux list-sessions -F '#S' |
    fzf --multi --prompt 'kill> ' --preview 'tmux capture-pane -ep -t {}:')}")
fi
for s in $sessions; do
  [[ -n $s ]] && tmux kill-session -t "=$s" && print "killed $s"
done
