{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "workmux-status@workmux": true
  },
  "extraKnownMarketplaces": {
    "workmux": {
      "source": {
        "source": "github",
        "repo": "raine/workmux"
      }
    }
  },
  "language": "French",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-title.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
